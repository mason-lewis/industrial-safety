# Startup performs no language model calls, even if a key is present.
AI_ENABLED=false
HOSTED_IMAGES_ALLOWED=false
# The only key the app needs. All agents use gpt-6-luna. The app reads .env from the
# repository folder first, then from the folder one level above it.
OPENAI_API_KEY=
AI_DEFAULT_MODEL=gpt-6-luna
# Omit to use the model default. Never use the literal "default".
AI_REASONING_EFFORT=
AI_LIVE_REQUEST_LIMIT=3
AI_LIVE_TOKEN_LIMIT=16000
AI_LIVE_IMAGE_LIMIT=32
AI_LIVE_DEADLINE_S=20
AI_QUEUE_LIMIT=4
# Backend-only RTSP credentials are configured by camera env name, never sent to UI.
LAB_RTSP_URL=

# Bounds across this playback session/generation, including retrospective calls.
AI_RUN_REQUEST_LIMIT=100
AI_RUN_TOKEN_LIMIT=200000
AI_SPECIALISTS_ENABLED=false
# Optional configured USD rates per million tokens. Missing rates mean cost unknown.
AI_PRICE_INPUT_PER_MILLION=
AI_PRICE_CACHED_INPUT_PER_MILLION=
AI_PRICE_OUTPUT_PER_MILLION=

# Legacy Monitoring/Labeling automation stays off; Live/Review uses its own shared workflow.
AI_ALWAYS_ON=false
# ./start enables real AI for videos you open; --offline disables it.
# The top AI switch persists globally, independently of this launch permission.
SAFETY_PAID_REVIEW=1
