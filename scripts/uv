#!/bin/sh
set -eu
LAB_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export UV_PYTHON_INSTALL_DIR="$LAB_ROOT/.tools/python"
export UV_CACHE_DIR="$LAB_ROOT/.uv-cache"
if [ -x "$LAB_ROOT/.tools/uv" ]; then
  exec "$LAB_ROOT/.tools/uv" "$@"
fi
if command -v uv >/dev/null 2>&1; then
  exec uv "$@"
fi
if [ ! -x "$LAB_ROOT/.tools/bootstrap/bin/uv" ]; then
  python3 -m venv "$LAB_ROOT/.tools/bootstrap"
  "$LAB_ROOT/.tools/bootstrap/bin/python" -m pip install --disable-pip-version-check uv==0.12.23
fi
exec "$LAB_ROOT/.tools/bootstrap/bin/uv" "$@"
